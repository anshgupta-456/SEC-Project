# Copy this file to backend/.env and adjust. backend/.env is git-ignored.

# --- Database ---
# Leave unset to use a local SQLite file (backend/instance/grievance.db).
# For MySQL (URL-encode special characters in the password, e.g. @ -> %40):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/grievance_management_system_db

# --- Auth ---
# Use a long random string in any shared/deployed environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# --- Services ---
HOST=127.0.0.1
USER_SERVICE_PORT=5000
GRIEVANCE_SERVICE_PORT=5001
ADMIN_SERVICE_PORT=5002
FLASK_DEBUG=false
SQL_ECHO=false
# Comma-separated list of allowed frontend origins ("*" is fine for local dev,
# auth uses bearer tokens rather than cookies).
CORS_ORIGINS=*
MAX_UPLOAD_MB=16

# --- ML / external APIs ---
# Optional: used to translate Hindi/Marathi/Gujarati grievances to English
# before classification. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# true  = use the facebook/bart-large-mnli zero-shot model (needs requirements-ml.txt,
#         downloads ~1.6 GB on first use)
# false = use the built-in keyword classifier only
ENABLE_ML_CLASSIFIER=true

# --- First admin (optional) ---
# Created by `python manage.py init-db` (and on every container start) if no
# admin with this email exists yet. Never changes an existing admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
