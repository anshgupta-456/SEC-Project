# Frontend settings — copy to .env.local (git-ignored).

# Leave empty when the backend serves the frontend (Docker / backend/wsgi.py)
# or during `npm run dev` (Vite proxies /api to the backend).
# Set it only when the frontend is hosted separately, e.g. on Vercel:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# Dev only: proxy /api to the single combined backend instead of the three
# services started by `python backend/apprunner.py`.
# VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
